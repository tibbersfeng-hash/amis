                          {
                            "type": "select",
                            "name": "source",
                            "label": "Source",
                            "options": [
                              {
                                "label": "Direct",
                                "value": "DIRECT"
                              },
                              {
                                "label": "OTA",
                                "value": "OTA"
                              }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "select",
                            "name": "marketCode",
                            "label": "Market Code",
                            "options": [
                              {
                                "label": "GDS",
                                "value": "GDS"
                              },
                              {
                                "label": "CORPORATE",
                                "value": "CORPORATE"
                              }
                            ],
                            "placeholder": "Please Select"
                          },
                          {
                            "type": "select",
                            "name": "rateCode",
                            "label": "Rate Code",
                            "options": [
                              {
                                "label": "RACK",
                                "value": "RACK"
                              },
                              {
                                "label": "BAR",
                                "value": "BAR"
                              }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "select",
                            "name": "roomCategory",
                            "label": "Room Category",
                            "options": [
                              {
                                "label": "Deluxe",
                                "value": "DELUXE"
                              },
                              {
                                "label": "Premier",
                                "value": "PREMIER"
                              }
                            ],
                            "placeholder": "Please Select"
                          },
                          {
                            "type": "select",
                            "name": "roomType",
                            "label": "Room Type",
                            "options": [
                              {
                                "label": "King",
                                "value": "KING"
                              },
                              {
                                "label": "Twin",
                                "value": "TWIN"
                              }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "date-range-picker",
                        "startName": "subStayStart",
                        "endName": "subStayEnd",
                        "required": false,
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "validationText": "<div class=\"cxd-Form-validation is-error\" style=\"color:var(--danger);font-size:12px;line-height:1;margin-top:4px;\">End time must be after start time</div>"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"cxd-Form-validation is-error\" style=\"color:var(--danger);font-size:12px;line-height:1;margin-top:4px;\">End time must be after start time</div>",
                        "inline": false,
                        "visibleOn": "${subStayEnd && subStayStart && subStayEnd <= subStayStart}"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Registration Award</div>",
                        "inline": false
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"radio-group\"><label class=\"radio-item\"><input type=\"radio\" name=\"regAwardType\" value=\"AWARD_POINTS\" checked> Award Points</label><label class=\"radio-item\"><input type=\"radio\" name=\"regAwardType\" value=\"AWARD_VOUCHER\"> Voucher</label><label class=\"radio-item\"><input type=\"radio\" name=\"regAwardType\" value=\"NO_AWARD\"> No Award</label></div>",
                        "inline": false
                      },
                      {
                        "type": "wrapper",
                        "className": "award-panel",
                        "body": {
                          "type": "form",
                          "mode": "normal",
                          "wrapWithPanel": false,
                          "body": [
                            {
                              "type": "input-number",
                              "name": "awardPoints",
                              "label": "Award Points",
                              "placeholder": "Please input"
                            },
                            {
                              "type": "select",
                              "name": "billingCode",
                              "label": "Billing Code",
