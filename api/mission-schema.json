                            },
                            {
                              "type": "input-text",
                              "name": "transactionNote",
                              "label": "Transaction Note",
                              "placeholder": "Please input"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              {
                "title": "Skin Setting",
                "hash": "skin-setting",
