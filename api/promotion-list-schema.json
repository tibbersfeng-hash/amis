{
  "type": "page",
  "title": "",
  "className": "list-root",
  "body": [
    {
      "type": "wrapper",
      "className": "page-header-bar",
      "body": [
        {
          "type": "tpl",
          "tpl": "<h1 class=\"page-title\">Promotion List</h1>",
          "inline": false
        }
      ]
    },
    {
      "type": "form",
      "mode": "inline",
      "wrapWithPanel": false,
      "className": "search-form",
      "body": [
        {
          "type": "input-text",
          "name": "searchName",
          "label": "Promotion Name",
          "placeholder": "Please Input",
          "clearable": true,
          "size": "md"
        },
        {
          "type": "select",
          "name": "searchType",
          "label": "Promotion Type",
          "options": [
            { "label": "All Types", "value": "" },
            { "label": "Flash Sale", "value": "flash_sale" },
            { "label": "Bundle Deal", "value": "bundle_deal" },
            { "label": "Tiered Discount", "value": "tiered_discount" },
            { "label": "Gift with Purchase", "value": "gift_purchase" }
          ],
          "clearable": true,
          "size": "md"
        },
        {
          "type": "select",
          "name": "searchStatus",
          "label": "Status",
          "options": [
            { "label": "All Status", "value": "" },
            { "label": "Draft", "value": "draft" },
            { "label": "Active", "value": "active" },
            { "label": "Paused", "value": "paused" },
            { "label": "Expired", "value": "expired" }
          ],
          "clearable": true,
          "size": "md"
        },
        {
          "type": "input-date-range",
          "name": "activePeriod",
          "label": "Active Period",
          "format": "YYYY-MM-DD",
          "size": "md"
        }
      ],
      "actions": []
    },
    {
      "type": "divider",
      "className": "search-divider"
    },
    {
      "type": "wrapper",
      "className": "search-actions-row",
      "body": [
        {
          "type": "button",
          "label": "Clear",
          "actionType": "custom",
          "script": "var form=document.querySelector('.search-form');if(form){var items=form.querySelectorAll('input[type=\"text\"],input[type=\"date\"],select');items.forEach(function(i){i.value='';i.dispatchEvent(new Event('input',{bubbles:true}));});}",
          "className": "btn-clear",
          "size": "md"
        },
        {
          "type": "button",
          "label": "Search",
          "actionType": "submit",
          "target": "search-form",
          "primary": true,
          "className": "btn-search",
          "size": "md"
        }
      ]
    },
    {
      "type": "wrapper",
      "className": "add-btn-row",
      "body": [
        {
          "type": "button",
          "label": "+ Add",
          "className": "btn-add",
          "actionType": "link",
          "link": "index.html?page=promotion"
        }
      ]
    },
    {
      "type": "crud",
      "api": {
        "method": "get",
        "url": "/api/promotion-list-config.json"
      },
      "syncLocation": false,
      "perPage": 10,
      "perPageAvailable": [10, 20, 50],
      "columns": [
        {
          "name": "promotionCode",
          "label": "Promotion Code / Name",
          "type": "tpl",
          "tpl": "<div class=\"cell-code\">${promotionCode}</div><div><a href=\"index.html?page=promotion&id=${id}\" class=\"cell-name\">${promotionName}</a></div>",
          "width": 200
        },
        {
          "name": "promotionType",
          "label": "Promotion Type",
          "type": "mapping",
          "map": {
            "flash_sale": "<span class=\"type-flash-sale\">Flash Sale</span>",
            "bundle_deal": "<span class=\"type-bundle\">Bundle Deal</span>",
            "tiered_discount": "<span class=\"type-tiered\">Tiered Discount</span>",
            "gift_purchase": "<span class=\"type-gift\">Gift with Purchase</span>"
          },
          "width": 140
        },
        {
          "name": "activeStart",
          "label": "Active Period",
          "type": "tpl",
          "tpl": "<div>${activeStart}</div><div>${activeEnd}</div>",
          "width": 120
        },
        {
          "name": "targetAudience",
          "label": "Target Audience",
          "type": "mapping",
          "map": {
            "all": "<span class=\"audience-all\">All Members</span>",
            "vip": "<span class=\"audience-vip\">VIP Only</span>",
            "new_members": "<span class=\"audience-new\">New Members</span>",
            "segment": "<span class=\"audience-segment\">Segment</span>"
          },
          "width": 120
        },
        {
          "name": "discountType",
          "label": "Discount Type",
          "type": "mapping",
          "map": {
            "percentage": "<span class=\"discount-percent\">%</span>",
            "fixed": "<span class=\"discount-fixed\">Fixed</span>",
            "points_multiplier": "<span class=\"discount-points\">Points x</span>"
          },
          "width": 100
        },
        {
          "name": "budget",
          "label": "Budget",
          "type": "tpl",
          "tpl": "${currency} ${budget}",
          "width": 100
        },
        {
          "name": "status",
          "label": "Status",
          "type": "mapping",
          "map": {
            "draft": "<span class=\"promo-status-dot draft\"></span>Draft",
            "active": "<span class=\"promo-status-dot active\"></span>Active",
            "paused": "<span class=\"promo-status-dot paused\"></span>Paused",
            "expired": "<span class=\"promo-status-dot expired\"></span>Expired"
          },
          "width": 100
        },
        {
          "name": "participationCount",
          "label": "Participation",
          "width": 100
        },
        {
          "type": "operation",
          "label": "Operation",
          "fixed": "right",
          "width": 100,
          "buttons": [
            {
              "type": "link",
              "label": "View",
              "className": "action-link action-view",
              "link": "index.html?page=promotion&id=${id}"
            },
            {
              "type": "link",
              "label": "Edit",
              "className": "action-link action-edit",
              "link": "index.html?page=promotion&id=${id}"
            }
          ],
          "placeholder": "-",
          "toggled": true
        }
      ],
      "headerToolbar": [],
      "footerToolbar": ["statistics", "pagination"]
    }
  ]
}
