{
  "type": "page",
  "className": "mission-root",
  "data": {},
  "body": [
    {
      "type": "wrapper",
      "className": "page-header-bar",
      "body": [
        {
          "type": "tpl",
          "tpl": "<h1 class=\"page-title\">Component Showcase Form</h1>",
          "inline": false
        },
        {
          "type": "button",
          "label": "Return to List",
          "className": "return-link",
          "actionType": "link",
          "link": "index.html?page=list"
        }
      ]
    },
    {
      "type": "wrapper",
      "className": "mission-body-split",
      "body": [
        {
          "type": "wrapper",
          "className": "mission-left",
          "body": {
            "type": "wrapper",
            "className": "form-card",
            "body": {
              "type": "form",
              "mode": "normal",
              "wrapWithPanel": false,
              "body": [
                {
                  "type": "tpl",
                  "tpl": "<div class=\"section-title\">Basic Information<span class=\"asterisk\">*</span></div>",
                  "inline": false
                },
                {
                  "type": "input-text",
                  "name": "title",
                  "label": "Title",
                  "sourcePath": "basicInfo",
                  "required": true,
                  "placeholder": "Please enter the title",
                  "description": "The display title of this item",
                  "clearValueOnHidden": false,
                  "trimContents": true,
                  "minLength": 2,
                  "maxLength": 100,
                  "validateOnChange": true
                },
                {
                  "type": "input-textarea",
                  "name": "description",
                  "label": "Description",
                  "sourcePath": "basicInfo",
                  "placeholder": "Please enter a detailed description",
                  "rows": 4,
                  "maxLength": 500,
                  "showCounter": true,
                  "description": "Supports up to 500 characters"
                },
                {
                  "type": "input-number",
                  "name": "priority",
                  "label": "Priority",
                  "sourcePath": "basicInfo",
                  "required": true,
                  "placeholder": "Please enter a number",
                  "min": 1,
                  "max": 99,
                  "step": 1,
                  "precision": 0,
                  "prefix": "#",
                  "suffix": "rank",
                  "description": "Lower number means higher priority"
                },
                {
                  "type": "divider",
                  "lineStyle": { "color": "#E8E8E8" }
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"section-title\">Scheduling</div>",
                  "inline": false
                },
                {
                  "type": "date-range-picker",
                  "startName": "startTime",
                  "endName": "endTime",
                  "sourcePath": "schedule.period",
                  "required": true,
                  "format": "YYYY-MM-DD HH:mm:ss",
                  "description": "Select the active period for this item",
                  "validationText": "<div class=\"cxd-Form-validation is-error\" style=\"color:var(--danger);font-size:12px;line-height:1;margin-top:4px;\">End time must be after start time</div>"
                },
                {
                  "type": "input-date",
                  "name": "deadline",
                  "label": "Deadline",
                  "sourcePath": "schedule",
                  "required": true,
                  "format": "YYYY-MM-DD",
                  "inputFormat": "YYYY-MM-DD",
                  "placeholder": "Select a deadline date",
                  "description": "The final deadline for submission",
                  "closeOnSelect": true
                },
                {
                  "type": "divider",
                  "lineStyle": { "color": "#E8E8E8" }
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"section-title\">Configuration</div>",
                  "inline": false
                },
                {
                  "type": "select",
                  "name": "category",
                  "label": "Category",
                  "sourcePath": "config",
                  "required": true,
                  "options": [
                    { "label": "Marketing Campaign", "value": "marketing" },
                    { "label": "User Engagement", "value": "engagement" },
                    { "label": "Loyalty Program", "value": "loyalty" },
                    { "label": "Seasonal Promotion", "value": "seasonal" },
                    { "label": "Flash Sale", "value": "flash_sale" }
                  ],
                  "placeholder": "Please select a category",
                  "clearable": true,
                  "multiple": false,
                  "extractValue": true
                },
                {
                  "type": "select",
                  "name": "tags",
                  "label": "Tags",
                  "sourcePath": "config",
                  "sourceKey": "tags",
                  "options": [
                    { "label": "Featured", "value": "featured" },
                    { "label": "New Arrival", "value": "new" },
                    { "label": "Popular", "value": "popular" },
                    { "label": "Limited Edition", "value": "limited" },
                    { "label": "VIP Only", "value": "vip" },
                    { "label": "Member Exclusive", "value": "exclusive" }
                  ],
                  "placeholder": "Select one or more tags",
                  "multiple": true,
                  "clearable": true,
                  "extractValue": true,
                  "joinValues": false
                },
                {
                  "type": "group",
                  "body": [
                    {
                      "type": "input-color",
                      "name": "primaryColor",
                      "label": "Primary Color",
                      "sourcePath": "config.theme",
                      "description": "Main theme color"
                    },
                    {
                      "type": "input-color",
                      "name": "secondaryColor",
                      "label": "Secondary Color",
                      "sourcePath": "config.theme",
                      "description": "Accent color"
                    }
                  ]
                },
                {
                  "type": "divider",
                  "lineStyle": { "color": "#E8E8E8" }
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"section-title\">Status & Options</div>",
                  "inline": false
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"section-title-sm\">Publish Status</div>",
                  "inline": false
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"radio-group\"><label class=\"radio-item\"><input type=\"radio\" name=\"publishStatus\" value=\"draft\"> Draft</label><label class=\"radio-item\"><input type=\"radio\" name=\"publishStatus\" value=\"published\" checked> Published</label><label class=\"radio-item\"><input type=\"radio\" name=\"publishStatus\" value=\"archived\"> Archived</label></div>",
                  "inline": false
                },
                {
                  "type": "input-switch",
                  "name": "enableNotifications",
                  "label": "Enable Notifications",
                  "sourcePath": "config",
                  "option": "On",
                  "onText": "On",
                  "offText": "Off",
                  "description": "Send push notifications to users when activated"
                },
                {
                  "type": "input-switch",
                  "name": "allowSharing",
                  "label": "Allow Sharing",
                  "sourcePath": "config",
                  "option": "Allow",
                  "onText": "Allow",
                  "offText": "Deny",
                  "description": "Allow users to share this content"
                },
                {
                  "type": "divider",
                  "lineStyle": { "color": "#E8E8E8" }
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"section-title\">Media & Links</div>",
                  "inline": false
                },
                {
                  "type": "input-image",
                  "name": "coverImage",
                  "label": "Cover Image",
                  "sourcePath": "media",
                  "required": true,
                  "multiple": false,
                  "description": "Recommended: 1200px x 800px, max 10MB",
                  "accept": "image/png,image/jpeg,image/gif,image/webp"
                },
                {
                  "type": "input-image",
                  "name": "galleryImages",
                  "label": "Gallery Images",
                  "sourcePath": "media",
                  "sourceKey": "gallery",
                  "multiple": true,
                  "limit": 5,
                  "description": "Upload up to 5 images for the gallery",
                  "accept": "image/png,image/jpeg,image/webp"
                },
                {
                  "type": "input-url",
                  "name": "externalLink",
                  "label": "External Link",
                  "sourcePath": "media",
                  "placeholder": "https://example.com",
                  "description": "Link to an external resource",
                  "validateUrl": true,
                  "protocol": "https"
                },
                {
                  "type": "input-url",
                  "name": "shareLink",
                  "label": "Share Link",
                  "sourcePath": "media",
                  "placeholder": "https://example.com/share",
                  "description": "Custom share link for social media",
                  "validateUrl": true,
                  "protocol": "https"
                },
                {
                  "type": "divider",
                  "lineStyle": { "color": "#E8E8E8" }
                },
                {
                  "type": "tpl",
                  "tpl": "<div class=\"section-title\">Rich Content</div>",
                  "inline": false
                },
                {
                  "type": "editor",
                  "name": "detailContent",
                  "label": "Detail Content",
                  "sourcePath": "content",
                  "required": true,
                  "language": "html",
                  "size": "lg",
                  "placeholder": "Enter the detailed content here...",
                  "description": "Supports HTML formatting, images, and rich text",
                  "options": {
                    "minLines": 10,
                    "showPrintMargin": false
                  }
                },
                {
                  "type": "editor",
                  "name": "termsContent",
                  "label": "Terms & Conditions",
                  "sourcePath": "content",
                  "sourceKey": "terms",
                  "language": "html",
                  "size": "lg",
                  "placeholder": "Enter the terms and conditions...",
                  "description": "Legal terms displayed to end users",
                  "options": {
                    "minLines": 6,
                    "showPrintMargin": false
                  }
                }
              ]
            }
          }
        },
        {
          "type": "wrapper",
          "className": "mission-right",
          "body": {
            "type": "wrapper",
            "className": "preview-panel",
            "body": [
              {
                "type": "tpl",
                "tpl": "<div class=\"language-switcher\"><span class=\"language-label\">Preview Language:</span><select class=\"language-select\" onchange=\"window.__onPreviewLanguageChange && window.__onPreviewLanguageChange(this.value)\"><option value=\"zh\">中文</option><option value=\"en\">English</option></select></div>",
                "inline": false
              },
              {
                "type": "wrapper",
                "className": "phone-card",
                "body": { "type": "phone-mockup" }
              }
            ]
          }
        }
      ]
    }
  ]
}
