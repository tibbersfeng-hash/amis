{
  "type": "page",
  "className": "mission-root",
  "data": {},
  "body": [
    {
      "type": "wrapper",
      "className": "page-header-bar",
      "body": [
        {
          "type": "tpl",
          "tpl": "<h1 class=\"page-title\">Add Promotion</h1>",
          "inline": false
        },
        {
          "type": "button",
          "label": "Return to List",
          "className": "return-link",
          "actionType": "link",
          "link": "index.html?page=promotion-list"
        }
      ]
    },
    {
      "type": "form",
      "mode": "normal",
      "wrapWithPanel": false,
      "body": [
        {
          "type": "tabs",
          "tabsMode": "line",
          "className": "mb-3",
          "mountOnEnter": false,
          "unmountOnExit": false,
          "tabs": [
            {
              "title": "Basic Info",
              "hash": "basic-info",
              "body": {
                "type": "wrapper",
                "className": "tab-body",
                "body": [
                  {
                    "type": "wrapper",
                    "className": "tab-left",
                    "body": {
                      "type": "wrapper",
                      "className": "form-card",
                      "body": [
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-text",
                              "name": "promotionCode",
                              "label": "Promotion Code",
                              "sourcePath": "basicInfo.promotionCode",
                              "required": true,
                              "placeholder": "Please input"
                            },
                            {
                              "type": "input-text",
                              "name": "promotionName",
                              "label": "Promotion Name",
                              "sourcePath": "basicInfo.promotionName",
                              "required": true,
                              "placeholder": "Please input"
                            }
                          ]
                        },
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"hint-text\">Format: PROMO_YYYYMMDD_XXX</div>",
                          "inline": false
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "select",
                              "name": "promotionType",
                              "label": "Promotion Type",
                              "sourcePath": "basicInfo.promotionType",
                              "required": true,
                              "options": [
                                { "label": "Flash Sale", "value": "flash_sale" },
                                { "label": "Bundle Deal", "value": "bundle_deal" },
                                { "label": "Tiered Discount", "value": "tiered_discount" },
                                { "label": "Gift with Purchase", "value": "gift_purchase" }
                              ],
                              "placeholder": "Please Select"
                            },
                            {
                              "type": "select",
                              "name": "targetAudience",
                              "label": "Target Audience",
                              "sourcePath": "basicInfo.targetAudience",
                              "required": true,
                              "options": [
                                { "label": "All Members", "value": "all" },
                                { "label": "VIP Only", "value": "vip" },
                                { "label": "New Members", "value": "new_members" },
                                { "label": "Segment", "value": "segment" }
                              ],
                              "placeholder": "Please Select"
                            }
                          ]
                        },
                        {
                          "type": "input-text",
                          "name": "segmentId",
                          "label": "Segment ID",
                          "sourcePath": "basicInfo.segmentId",
                          "visibleOn": "${targetAudience == 'segment'}",
                          "required": true,
                          "placeholder": "Enter segment identifier"
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-number",
                              "name": "flashSaleDuration",
                              "label": "Duration (hours)",
                              "sourcePath": "basicInfo.flashSaleDuration",
                              "visibleOn": "${promotionType == 'flash_sale'}",
                              "required": true,
                              "placeholder": "e.g. 24"
                            },
                            {
                              "type": "input-datetime",
                              "name": "flashSaleStartTime",
                              "label": "Flash Sale Start Time",
                              "sourcePath": "basicInfo.flashSaleStartTime",
                              "visibleOn": "${promotionType == 'flash_sale'}",
                              "required": true,
                              "format": "YYYY-MM-DD HH:mm:ss",
                              "timeFormat": "HH:mm:ss",
                              "inputFormat": "YYYY-MM-DD HH:mm:ss"
                            }
                          ]
                        },
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"section-title-sm\">Active Period<span class=\"asterisk\">*</span></div>",
                          "inline": false
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-datetime",
                              "name": "activeStartTime",
                              "label": "",
                              "sourcePath": "basicInfo.activeStartTime",
                              "required": true,
                              "format": "YYYY-MM-DD HH:mm:ss",
                              "timeFormat": "HH:mm:ss",
                              "inputFormat": "YYYY-MM-DD HH:mm:ss",
                              "clearable": false
                            },
                            {
                              "type": "input-datetime",
                              "name": "activeEndTime",
                              "label": "",
                              "sourcePath": "basicInfo.activeEndTime",
                              "required": true,
                              "format": "YYYY-MM-DD HH:mm:ss",
                              "timeFormat": "HH:mm:ss",
                              "inputFormat": "YYYY-MM-DD HH:mm:ss",
                              "clearable": false,
                              "minDate": "${activeStartTime}",
                              "validations": { "isAfter": "${activeStartTime}" },
                              "validationErrors": { "isAfter": "End time must be after start time" }
                            }
                          ]
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-number",
                              "name": "budget",
                              "label": "Budget",
                              "sourcePath": "basicInfo.budget",
                              "requiredOn": "${targetAudience != 'all'}",
                              "placeholder": "Enter budget amount"
                            },
                            {
                              "type": "select",
                              "name": "currency",
                              "label": "Currency",
                              "sourcePath": "basicInfo.currency",
                              "options": [
                                { "label": "HKD", "value": "HKD" },
                                { "label": "USD", "value": "USD" },
                                { "label": "CNY", "value": "CNY" },
                                { "label": "JPY", "value": "JPY" }
                              ],
                              "placeholder": "Please Select"
                            }
                          ]
                        },
                        {
                          "type": "textarea",
                          "name": "description",
                          "label": "Description",
                          "sourcePath": "basicInfo.description",
                          "placeholder": "Enter promotion description",
                          "rows": 3
                        }
                      ]
                    }
                  },
                  {
                    "type": "wrapper",
                    "className": "tab-right",
                    "body": {
                      "type": "wrapper",
                      "className": "preview-panel",
                      "body": [
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"language-switcher\"><span class=\"language-label\">Preview Language:</span><select class=\"language-select\" onchange=\"window.__onPreviewLanguageChange && window.__onPreviewLanguageChange(this.value)\"><option value=\"zh\">中文</option><option value=\"en\">English</option></select></div>",
                          "inline": false
                        },
                        {
                          "type": "wrapper",
                          "className": "phone-card",
                          "body": { "type": "phone-mockup" }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "title": "Eligibility Rules",
              "hash": "eligibility-rules",
              "body": {
                "type": "wrapper",
                "className": "tab-body",
                "body": [
                  {
                    "type": "wrapper",
                    "className": "tab-left",
                    "body": {
                      "type": "wrapper",
                      "className": "form-card",
                      "body": [
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-number",
                              "name": "minPurchaseAmount",
                              "label": "Min Purchase Amount",
                              "sourcePath": "eligibilityRules.minPurchaseAmount",
                              "placeholder": "e.g. 500"
                            },
                            {
                              "type": "input-number",
                              "name": "minPurchaseItems",
                              "label": "Min Purchase Items",
                              "sourcePath": "eligibilityRules.minPurchaseItems",
                              "placeholder": "e.g. 1"
                            }
                          ]
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-number",
                              "name": "maxUsagePerUser",
                              "label": "Max Usage Per User",
                              "sourcePath": "eligibilityRules.maxUsagePerUser",
                              "placeholder": "e.g. 3"
                            },
                            {
                              "type": "input-number",
                              "name": "totalUsageLimit",
                              "label": "Total Usage Limit",
                              "sourcePath": "eligibilityRules.totalUsageLimit",
                              "placeholder": "e.g. 10000"
                            }
                          ]
                        },
                        {
                          "type": "divider",
                          "lineStyle": { "color": "#E8E8E8" }
                        },
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"section-title-sm\">Discount Configuration</div>",
                          "inline": false
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "select",
                              "name": "discountType",
                              "label": "Discount Type",
                              "sourcePath": "eligibilityRules.discountType",
                              "disabledOn": "${promotionType == 'bundle_deal'}",
                              "options": [
                                { "label": "Percentage", "value": "percentage" },
                                { "label": "Fixed Amount", "value": "fixed" },
                                { "label": "Points Multiplier", "value": "points_multiplier" }
                              ],
                              "placeholder": "Please Select",
                              "onChange": {
                                "actionType": "setValue",
                                "args": {
                                  "value": {
                                    "discountValue": "${IF(discountType == 'percentage', 10, IF(discountType == 'fixed', 100, 2))}"
                                  }
                                }
                              }
                            },
                            {
                              "type": "input-number",
                              "name": "discountValue",
                              "label": "Discount Value",
                              "sourcePath": "eligibilityRules.discountValue",
                              "placeholder": "Auto-filled based on type"
                            }
                          ]
                        },
                        {
                          "type": "static",
                          "name": "effectiveDiscount",
                          "label": "Effective Discount",
                          "value": "${IF(discountType == 'percentage', CONCAT(discountValue, '%'), IF(discountType == 'fixed', CONCAT(currency, ' ', discountValue), CONCAT('x', discountValue)))}"
                        },
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"section-title-sm\">Stacking Rules</div>",
                          "inline": false
                        },
                        {
                          "type": "switch",
                          "name": "stackableWithOtherPromos",
                          "label": "Stackable with Other Promotions",
                          "sourcePath": "eligibilityRules.stackableWithOtherPromos",
                          "disabledOn": "${promotionType == 'flash_sale'}"
                        }
                      ]
                    }
                  },
                  {
                    "type": "wrapper",
                    "className": "tab-right",
                    "body": {
                      "type": "wrapper",
                      "className": "preview-panel",
                      "body": [
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"language-switcher\"><span class=\"language-label\">Preview Language:</span><select class=\"language-select\" onchange=\"window.__onPreviewLanguageChange && window.__onPreviewLanguageChange(this.value)\"><option value=\"zh\">中文</option><option value=\"en\">English</option></select></div>",
                          "inline": false
                        },
                        {
                          "type": "wrapper",
                          "className": "phone-card",
                          "body": {
                            "type": "tpl",
                            "tpl": "<div style=\"padding:24px;text-align:center;color:var(--text-secondary);font-size:13px;\">Preview for Eligibility Rules</div>",
                            "inline": false
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "title": "Display & Content",
              "hash": "display-content",
              "body": {
                "type": "wrapper",
                "className": "tab-body",
                "body": [
                  {
                    "type": "wrapper",
                    "className": "tab-left",
                    "body": {
                      "type": "wrapper",
                      "className": "form-card",
                      "body": [
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"section-title-sm\">Banner Image</div>",
                          "inline": false
                        },
                        {
                          "type": "input-image",
                          "name": "bannerImage",
                          "label": "",
                          "sourcePath": "displayContent.bannerImage"
                        },
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"hint-text\">Recommended: 1200px × 400px</div>",
                          "inline": false
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-text",
                              "name": "bannerTitle",
                              "label": "Banner Title",
                              "sourcePath": "displayContent.bannerTitle",
                              "placeholder": "Follows preview language"
                            },
                            {
                              "type": "input-text",
                              "name": "bannerSubtitle",
                              "label": "Banner Subtitle",
                              "sourcePath": "displayContent.bannerSubtitle",
                              "placeholder": "Follows preview language"
                            }
                          ]
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-text",
                              "name": "ctaText",
                              "label": "CTA Text",
                              "sourcePath": "displayContent.ctaText",
                              "placeholder": "Follows preview language"
                            },
                            {
                              "type": "input-url",
                              "name": "ctaLink",
                              "label": "CTA Link",
                              "sourcePath": "displayContent.ctaLink",
                              "placeholder": "https://..."
                            }
                          ]
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "select",
                              "name": "displayPosition",
                              "label": "Display Position",
                              "sourcePath": "displayContent.displayPosition",
                              "options": [
                                { "label": "Homepage Banner", "value": "homepage_banner" },
                                { "label": "Category Page", "value": "category_page" },
                                { "label": "Product Detail", "value": "product_detail" },
                                { "label": "Cart Page", "value": "cart_page" }
                              ],
                              "placeholder": "Please Select"
                            },
                            {
                              "type": "input-number",
                              "name": "displayPriority",
                              "label": "Display Priority",
                              "sourcePath": "displayContent.displayPriority",
                              "placeholder": "Lower number = higher priority"
                            }
                          ]
                        },
                        {
                          "type": "input-image",
                          "name": "popupImage",
                          "label": "Popup Image",
                          "sourcePath": "displayContent.popupImage",
                          "visibleOn": "${displayPosition == 'homepage_banner'}"
                        },
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"section-title-sm\">Rich Content</div>",
                          "inline": false
                        },
                        {
                          "type": "editor",
                          "name": "richContent",
                          "label": "",
                          "sourcePath": "displayContent.richContent",
                          "language": "html",
                          "size": "lg",
                          "placeholder": "Enter rich content HTML"
                        },
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"section-title-sm\">T&C Content</div>",
                          "inline": false
                        },
                        {
                          "type": "editor",
                          "name": "tcContent",
                          "label": "",
                          "sourcePath": "displayContent.tcContent",
                          "language": "html",
                          "size": "lg",
                          "placeholder": "Enter terms & conditions HTML"
                        }
                      ]
                    }
                  },
                  {
                    "type": "wrapper",
                    "className": "tab-right",
                    "body": {
                      "type": "wrapper",
                      "className": "preview-panel",
                      "body": [
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"language-switcher\"><span class=\"language-label\">Preview Language:</span><select class=\"language-select\" onchange=\"window.__onPreviewLanguageChange && window.__onPreviewLanguageChange(this.value)\"><option value=\"zh\">中文</option><option value=\"en\">English</option></select></div>",
                          "inline": false
                        },
                        {
                          "type": "wrapper",
                          "className": "phone-card",
                          "body": {
                            "type": "tpl",
                            "tpl": "<div style=\"padding:24px;text-align:center;color:var(--text-secondary);font-size:13px;\">Preview for Display & Content</div>",
                            "inline": false
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "title": "Analytics Tracking",
              "hash": "analytics-tracking",
              "body": {
                "type": "wrapper",
                "className": "tab-body",
                "body": [
                  {
                    "type": "wrapper",
                    "className": "tab-left",
                    "body": {
                      "type": "wrapper",
                      "className": "form-card",
                      "body": [
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-text",
                              "name": "trackingCampaignId",
                              "label": "Campaign ID",
                              "sourcePath": "analyticsTracking.trackingCampaignId",
                              "placeholder": "e.g. summer_flash_2026"
                            },
                            {
                              "type": "input-text",
                              "name": "trackingSource",
                              "label": "Tracking Source",
                              "sourcePath": "analyticsTracking.trackingSource",
                              "placeholder": "e.g. shangri-la-app"
                            }
                          ]
                        },
                        {
                          "type": "input-text",
                          "name": "trackingMedium",
                          "label": "Tracking Medium",
                          "sourcePath": "analyticsTracking.trackingMedium",
                          "placeholder": "e.g. push_notification"
                        },
                        {
                          "type": "switch",
                          "name": "enableRealTimeTracking",
                          "label": "Enable Real-Time Tracking",
                          "sourcePath": "analyticsTracking.enableRealTimeTracking"
                        },
                        {
                          "type": "group",
                          "body": [
                            {
                              "type": "input-number",
                              "name": "trackingRefreshInterval",
                              "label": "Refresh Interval (seconds)",
                              "sourcePath": "analyticsTracking.trackingRefreshInterval",
                              "visibleOn": "${enableRealTimeTracking}",
                              "placeholder": "e.g. 30"
                            },
                            {
                              "type": "input-url",
                              "name": "trackingWebhookUrl",
                              "label": "Webhook URL",
                              "sourcePath": "analyticsTracking.trackingWebhookUrl",
                              "visibleOn": "${enableRealTimeTracking}",
                              "placeholder": "https://..."
                            }
                          ]
                        },
                        {
                          "type": "textarea",
                          "name": "customEvents",
                          "label": "Custom Events (JSON)",
                          "sourcePath": "analyticsTracking.customEvents",
                          "placeholder": "{\"event\":\"promotion_view\",\"category\":\"marketing\"}",
                          "rows": 4
                        }
                      ]
                    }
                  },
                  {
                    "type": "wrapper",
                    "className": "tab-right",
                    "body": {
                      "type": "wrapper",
                      "className": "preview-panel",
                      "body": [
                        {
                          "type": "tpl",
                          "tpl": "<div class=\"language-switcher\"><span class=\"language-label\">Preview Language:</span><select class=\"language-select\" onchange=\"window.__onPreviewLanguageChange && window.__onPreviewLanguageChange(this.value)\"><option value=\"zh\">中文</option><option value=\"en\">English</option></select></div>",
                          "inline": false
                        },
                        {
                          "type": "wrapper",
                          "className": "phone-card",
                          "body": {
                            "type": "tpl",
                            "tpl": "<div style=\"padding:24px;text-align:center;color:var(--text-secondary);font-size:13px;\">Preview for Analytics Tracking</div>",
                            "inline": false
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
