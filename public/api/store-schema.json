{
  "type": "page",
  "title": "多门店信息配置",
  "className": "mission-root",
  "body": [
    {
      "type": "form",
      "wrapWithPanel": false,
      "body": [
        {
          "type": "combo",
          "name": "stores",
          "label": "门店列表",
          "multiple": true,
          "addable": true,
          "removable": true,
          "editable": true,
          "draggable": true,
          "tabsMode": true,
          "tabsTitleField": "storeName",
          "className": "mission-combo-tabs",
          "addButtonText": "添加门店",
          "items": [
            {
              "type": "input-text",
              "name": "storeName",
              "label": "门店名称",
              "required": true,
              "placeholder": "请输入门店名称",
              "sourcePath": "stores[*].storeName"
            },
            {
              "type": "input-text",
              "name": "storeCode",
              "label": "门店编码",
              "required": true,
              "placeholder": "请输入门店编码",
              "sourcePath": "stores[*].storeCode"
            },
            {
              "type": "select",
              "name": "city",
              "label": "所在城市",
              "required": true,
              "placeholder": "请选择城市",
              "options": [
                { "label": "北京", "value": "beijing" },
                { "label": "上海", "value": "shanghai" },
                { "label": "广州", "value": "guangzhou" },
                { "label": "深圳", "value": "shenzhen" },
                { "label": "杭州", "value": "hangzhou" },
                { "label": "成都", "value": "chengdu" },
                { "label": "南京", "value": "nanjing" },
                { "label": "武汉", "value": "wuhan" },
                { "label": "西安", "value": "xian" },
                { "label": "重庆", "value": "chongqing" }
              ],
              "sourcePath": "stores[*].city"
            },
            {
              "type": "textarea",
              "name": "address",
              "label": "详细地址",
              "required": true,
              "placeholder": "请输入详细地址",
              "rows": 3,
              "sourcePath": "stores[*].address"
            },
            {
              "type": "input-text",
              "name": "phone",
              "label": "门店电话",
              "placeholder": "请输入门店电话",
              "sourcePath": "stores[*].phone"
            },
            {
              "type": "group",
              "label": "营业时间",
              "body": [
                {
                  "type": "input-text",
                  "name": "openTime",
                  "label": "开始时间",
                  "required": true,
                  "placeholder": "HH:mm",
                  "sourcePath": "stores[*].openTime"
                },
                {
                  "type": "input-text",
                  "name": "closeTime",
                  "label": "结束时间",
                  "required": true,
                  "placeholder": "HH:mm",
                  "sourcePath": "stores[*].closeTime"
                }
              ]
            },
            {
              "type": "input-text",
              "name": "managerName",
              "label": "店长姓名",
              "placeholder": "请输入店长姓名",
              "sourcePath": "stores[*].managerName"
            },
            {
              "type": "radios",
              "name": "status",
              "label": "门店状态",
              "required": true,
              "options": [
                { "label": "营业中", "value": "open" },
                { "label": "装修中", "value": "renovating" },
                { "label": "已关闭", "value": "closed" }
              ],
              "sourcePath": "stores[*].status"
            },
            {
              "type": "input-image",
              "name": "storeImage",
              "label": "门店图片",
              "multiple": false,
              "sourcePath": "stores[*].storeImage"
            }
          ]
        }
      ]
    }
  ]
}
