{
  "type": "page",
  "title": "信息管理",
  "body": [
    {
      "type": "tabs",
      "tabsMode": "line",
      "className": "form-tabs",
      "tabs": [
        {
          "title": "基本信息",
          "hash": "basic",
          "body": {
            "type": "form",
            "wrapWithPanel": false,
            "body": [
              {
                "type": "input-text",
                "name": "name",
                "label": "姓名",
                "placeholder": "请输入姓名",
                "required": true
              },
              {
                "type": "input-text",
                "name": "gender",
                "label": "性别",
                "placeholder": "请输入性别"
              },
              {
                "type": "input-text",
                "name": "age",
                "label": "年龄",
                "placeholder": "请输入年龄"
              },
              {
                "type": "input-text",
                "name": "idNumber",
                "label": "身份证号",
                "placeholder": "请输入身份证号"
              }
            ]
          }
        },
        {
          "title": "联系方式",
          "hash": "contact",
          "body": {
            "type": "form",
            "wrapWithPanel": false,
            "body": [
              {
                "type": "input-text",
                "name": "phone",
                "label": "手机号",
                "placeholder": "请输入手机号",
                "required": true
              },
              {
                "type": "input-text",
                "name": "email",
                "label": "邮箱",
                "placeholder": "请输入邮箱地址"
              },
              {
                "type": "input-text",
                "name": "address",
                "label": "通讯地址",
                "placeholder": "请输入详细地址"
              },
              {
                "type": "input-text",
                "name": "city",
                "label": "所在城市",
                "placeholder": "请输入城市名称"
              }
            ]
          }
        },
        {
          "title": "其他信息",
          "hash": "other",
          "body": {
            "type": "form",
            "wrapWithPanel": false,
            "body": [
              {
                "type": "input-text",
                "name": "occupation",
                "label": "职业",
                "placeholder": "请输入职业"
              },
              {
                "type": "input-text",
                "name": "company",
                "label": "公司名称",
                "placeholder": "请输入公司名称"
              },
              {
                "type": "input-text",
                "name": "source",
                "label": "信息来源",
                "placeholder": "请输入信息来源"
              },
              {
                "type": "input-text",
                "name": "remark",
                "label": "备注",
                "placeholder": "请输入备注信息"
              }
            ]
          }
        }
      ]
    }
  ]
}
