{
  "type": "page",
  "title": "",
  "className": "list-root",
  "body": [
    {
      "type": "wrapper",
      "className": "page-header-bar",
      "body": [
        {
          "type": "tpl",
          "tpl": "<h1 class=\"page-title\">数据列表</h1>",
          "inline": false
        }
      ]
    },
    {
      "type": "crud",
      "api": {
        "method": "get",
        "url": "/api/simple-list-config.json"
      },
      "syncLocation": false,
      "perPage": 10,
      "perPageAvailable": [10, 20, 50],
      "columns": [
        {
          "name": "id",
          "label": "ID",
          "type": "text",
          "width": 80
        },
        {
          "name": "name",
          "label": "名称",
          "type": "text",
          "width": 180
        },
        {
          "name": "category",
          "label": "分类",
          "type": "text",
          "width": 100
        },
        {
          "name": "status",
          "label": "状态",
          "type": "mapping",
          "map": {
            "1": "<span class=\"cell-yes\">启用</span>",
            "0": "<span class=\"cell-no\">草稿</span>",
            "2": "<span class=\"cell-no\">已停用</span>"
          },
          "width": 100
        },
        {
          "name": "priority",
          "label": "优先级",
          "type": "text",
          "width": 80
        },
        {
          "name": "creator",
          "label": "创建人",
          "type": "text",
          "width": 100
        },
        {
          "name": "createdAt",
          "label": "创建时间",
          "type": "date",
          "format": "YYYY-MM-DD HH:mm:ss",
          "width": 180
        },
        {
          "name": "updatedAt",
          "label": "更新时间",
          "type": "date",
          "format": "YYYY-MM-DD HH:mm:ss",
          "width": 180
        },
        {
          "type": "operation",
          "label": "操作",
          "fixed": "right",
          "width": 120,
          "buttons": [
            {
              "type": "link",
              "label": "查看",
              "className": "action-link action-view"
            },
            {
              "type": "link",
              "label": "编辑",
              "className": "action-link action-edit"
            }
          ],
          "placeholder": "-",
          "toggled": true
        }
      ],
      "headerToolbar": [],
      "footerToolbar": ["statistics", "pagination"]
    }
  ]
}
