    { "name": "restaurantName", "label": "餐厅名称", "sortable": true },
    { "name": "restaurantType", "label": "餐厅类型" },
    { "name": "hotelCode", "label": "所属酒店代码" },
    { "name": "floor", "label": "所在楼层" },
