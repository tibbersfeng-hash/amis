{
  "type": "page",
  "title": "富文本测试",
  "body": [
    {
      "type": "form",
      "wrapWithPanel": false,
      "mode": "horizontal",
      "horizontal": { "left": 3, "right": 9 },
      "body": [
        {
          "type": "input-rich-text-quill",
          "name": "richTextField",
          "label": "富文本字段",
          "placeholder": "请输入富文本内容",
          "receiver": "/api/upload",
          "maxLength": 5000
        },
        {
          "type": "input-rich-text-quill",
          "name": "richTextNoUpload",
          "label": "无上传富文本",
          "maxLength": 3000
        }
      ]
    }
  ]
}
