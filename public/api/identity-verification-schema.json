{
  "pageType": "formPage",
  "pageTitle": "身份验证",
  "className": "mission-root",
  "fields": [
    {
      "type": "select",
      "props": {
        "name": "documentType",
        "label": "证件类型",
        "required": true,
        "placeholder": "请选择证件类型",
        "options": [
          { "label": "身份证", "value": "idCard" },
          { "label": "护照", "value": "passport" },
          { "label": "驾驶证", "value": "driverLicense" }
        ]
      }
    },
    {
      "type": "input-text",
      "props": {
        "name": "idCardNumber",
        "label": "身份证号码",
        "required": true,
        "placeholder": "请输入18位身份证号码",
        "maxLength": 18,
        "visibleOn": "this.documentType == 'idCard'"
      }
    },
    {
      "type": "input-text",
      "props": {
        "name": "passportNumber",
        "label": "护照号码",
        "required": true,
        "placeholder": "请输入护照号码",
        "visibleOn": "this.documentType == 'passport'"
      }
    },
    {
      "type": "input-text",
      "props": {
        "name": "driverLicenseNumber",
        "label": "驾驶证号码",
        "required": true,
        "placeholder": "请输入驾驶证号码",
        "visibleOn": "this.documentType == 'driverLicense'"
      }
    },
    {
      "type": "input-text",
      "props": {
        "name": "name",
        "label": "姓名",
        "required": true,
        "placeholder": "请输入姓名"
      }
    },
    {
      "type": "input-image",
      "props": {
        "name": "idPhoto",
        "label": "证件照片",
        "required": true,
        "multiple": false
      }
    }
  ]
}
