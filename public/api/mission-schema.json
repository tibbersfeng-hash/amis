                      {
                        "type": "tpl",
                        "tpl": "<div class=\"radio-group\"><label class=\"radio-item\"><input type=\"radio\" name=\"specialAwardType\" value=\"AWARD_POINTS\" checked> Award Points</label><label class=\"radio-item\"><input type=\"radio\" name=\"specialAwardType\" value=\"AWARD_VOUCHER\"> Voucher</label><label class=\"radio-item\"><input type=\"radio\" name=\"specialAwardType\" value=\"NO_AWARD\"> No Award</label></div>",
                        "inline": false
                      },
                      {
                        "type": "wrapper",
                        "className": "award-panel",
                        "body": {
                          "type": "form",
                          "mode": "normal",
                          "wrapWithPanel": false,
                          "body": [
                            {
                              "type": "input-number",
                              "name": "specialAwardPoints",
