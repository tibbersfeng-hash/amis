{
  "type": "page",
  "className": "mission-root",
  "data": {},
  "body": [
    {
      "type": "wrapper",
      "className": "page-header-bar",
      "body": [
        {
          "type": "tpl",
          "tpl": "<h1 class=\"page-title\">Add Mission</h1>",
          "inline": false
        },
        {
          "type": "button",
          "label": "Return to List",
          "className": "return-link",
          "actionType": "link",
          "link": "index.html?page=list"
        }
      ]
    },
    {
      "type": "wrapper",
      "className": "mission-body-split",
      "body": [
        {
          "type": "wrapper",
          "className": "mission-left",
          "body": {
            "type": "tabs",
            "tabsMode": "line",
            "className": "mb-3",
            "mountOnEnter": false,
            "unmountOnExit": false,
            "tabs": [
              {
                "title": "Mission Setup",
                "hash": "mission-setup",
                "body": {
                  "type": "wrapper",
                  "className": "form-card",
                  "body": {
                    "type": "form",
                    "mode": "normal",
                    "wrapWithPanel": false,
                    "body": [
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title\">Mission Code<span class=\"asterisk\">*</span></div>",
                        "inline": false
                      },
                      {
                        "type": "input-text",
                        "name": "missionCode",
                        "label": "",
                        "sourcePath": "missionRule.ruleSetup",
                        "required": true,
                        "placeholder": "Please input"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"hint-text\">Format: MISSION_YYYYMMDD_XXX</div>",
                        "inline": false
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-text",
                            "name": "missionName",
                            "label": "Mission Name",
                            "sourcePath": "missionRule.ruleSetup",
                            "required": true,
                            "placeholder": "Please input"
                          },
                          {
                            "type": "input-text",
                            "name": "missionShortName",
                            "label": "Mission Short Name",
                            "sourcePath": "missionRule.displayConfig",
                            "placeholder": "Follows preview language"
                          }
                        ]
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Display in Mission Center</div>",
                        "inline": false
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"radio-group\"><label class=\"radio-item\"><input type=\"radio\" name=\"displayInCenter\" value=\"yes\"> Yes</label><label class=\"radio-item\"><input type=\"radio\" name=\"displayInCenter\" value=\"no\" checked> No</label></div>",
                        "inline": false
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title\" style=\"margin-top:24px;\">Registration Period<span class=\"asterisk\">*</span></div>",
                        "inline": false
                      },
                      {
                        "type": "date-range-picker",
                        "startName": "regStartTime",
                        "endName": "regEndTime",
                        "sourcePath": "missionRule.ruleSetup.registrationPeriod",
                        "required": true,
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "validationText": "<div class=\"cxd-Form-validation is-error\" style=\"color:var(--danger);font-size:12px;line-height:1;margin-top:4px;\">End time must be after start time</div>"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Mission Period<span class=\"asterisk\">*</span></div>",
                        "inline": false
                      },
                      {
                        "type": "date-range-picker",
                        "startName": "missionStartTime",
                        "endName": "missionEndTime",
                        "sourcePath": "missionRule.ruleSetup.missionPeriod",
                        "required": true,
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "validationText": "<div class=\"cxd-Form-validation is-error\" style=\"color:var(--danger);font-size:12px;line-height:1;margin-top:4px;\">End time must be after start time</div>"
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "select",
                            "name": "thresholdType",
                            "label": "Type",
                            "sourcePath": "missionRule.ruleSetup.minimumRegistration",
                            "sourceKey": "type",
                            "required": true,
                            "options": [
                              { "label": "No Limit", "value": "NO_LIMIT" },
                              { "label": "Limit to", "value": "LIMIT_TO" }
                            ]
                          },
                          {
                            "type": "input-number",
                            "name": "thresholdValue",
                            "label": "Quota",
                            "sourcePath": "missionRule.ruleSetup.quotation",
                            "sourceKey": "limitValue",
                            "placeholder": ""
                          },
                          {
                            "type": "tpl",
                            "tpl": "<div style=\"padding-top:32px;color:var(--text-secondary);font-size:13px;\">max SLC members</div>",
                            "inline": false
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-text",
                            "name": "registrationKeyword",
                            "label": "Registration Keyword",
                            "sourcePath": "missionRule.ruleSetup",
                            "required": true,
                            "placeholder": "Please Select"
                          },
                          {
                            "type": "input-text",
                            "name": "limitationKeyword",
                            "label": "Limitation Keyword",
                            "sourcePath": "missionRule.ruleSetup",
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Sequential or Non-sequential</div>",
                        "inline": false
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"radio-group\"><label class=\"radio-item\"><input type=\"radio\" name=\"sequenceType\" value=\"continue\" checked> Continuous</label><label class=\"radio-item\"><input type=\"radio\" name=\"sequenceType\" value=\"independent\"> Independent</label></div>",
                        "inline": false
                      },
                      {
                        "type": "divider",
                        "lineStyle": { "color": "#E8E8E8" }
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Mission Thumbnail</div>",
                        "inline": false
                      },
                      {
                        "type": "input-image",
                        "name": "missionThumbnail",
                        "label": "",
                        "sourcePath": "missionRule.displayConfig",
                        "multiple": false
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"hint-text\">Recommended Dimensions: 1200px × 800px, The Maximum size of the file is 10MB</div>",
                        "inline": false
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-text",
                            "name": "missionLongName",
                            "label": "Mission Long Name",
                            "sourcePath": "missionRule.displayConfig",
                            "placeholder": "Follows preview language"
                          },
                          {
                            "type": "input-text",
                            "name": "awardDescription",
                            "label": "Award Description",
                            "sourcePath": "missionRule.displayConfig",
                            "placeholder": "Follows preview language"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-text",
                            "name": "missionDescription",
                            "label": "Mission Description",
                            "sourcePath": "missionRule.displayConfig",
                            "placeholder": "Follows preview language"
                          },
                          {
                            "type": "input-text",
                            "name": "missionSegmentDescription",
                            "label": "Mission Segment Description",
                            "sourcePath": "missionRule.displayConfig",
                            "placeholder": "Follows preview language"
                          }
                        ]
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Mission Segment Icon</div>",
                        "inline": false
                      },
                      {
                        "type": "input-image",
                        "name": "missionSegmentIcon",
                        "label": "",
                        "sourcePath": "missionRule.displayConfig"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Mission Detail<span class=\"asterisk\">*</span></div>",
                        "inline": false
                      },
                      {
                        "type": "editor",
                        "name": "missionDetail",
                        "label": "",
                        "sourcePath": "missionRule.displayConfig",
                        "language": "html",
                        "size": "lg",
                        "placeholder": "Please input"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">T&C Link</div>",
                        "inline": false
                      },
                      {
                        "type": "input-url",
                        "name": "tcLink",
                        "label": "",
                        "sourcePath": "missionRule.displayConfig",
                        "placeholder": "Please input"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">T&C Content</div>",
                        "inline": false
                      },
                      {
                        "type": "editor",
                        "name": "tcContent",
                        "label": "",
                        "sourcePath": "missionRule.displayConfig",
                        "language": "html",
                        "size": "lg",
                        "placeholder": "Please input"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Share Link</div>",
                        "inline": false
                      },
                      {
                        "type": "input-url",
                        "name": "shareLink",
                        "label": "",
                        "sourcePath": "missionRule.displayConfig",
                        "placeholder": "Please input"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Start Mission</div>",
                        "inline": false
                      },
                      {
                        "type": "input-text",
                        "name": "startMission",
                        "label": "",
                        "sourcePath": "missionRule.displayConfig",
                        "placeholder": "Follows preview language"
                      }
                    ]
                  }
                }
              },
              {
                "title": "Sub-Mission Rules",
                "hash": "sub-mission-rules",
                "body": {
                  "type": "wrapper",
                  "className": "form-card",
                  "body": {
                    "type": "form",
                    "mode": "normal",
                    "wrapWithPanel": false,
                    "body": [
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"sub-tab-bar\"><span class=\"sub-tab-btn active\">Rule Setup</span><span class=\"sub-tab-btn\">Display</span></div>",
                        "inline": false
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "select",
                            "name": "subMissionType",
                            "label": "Sub Mission Type",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "required": true,
                            "options": [
                              { "label": "F&B Spending", "value": "FNB_SPENDING" },
                              { "label": "F&B Frequency", "value": "FNB_FREQUENCY" },
                              { "label": "Room Stay Nights", "value": "ROOM_STAY_NIGHTS" },
                              { "label": "Room Spending", "value": "ROOM_SPENDING" },
                              { "label": "Room Stay Prepaid Booking", "value": "ROOM_STAY_PREPAID" }
                            ],
                            "placeholder": "Please Select"
                          },
                          {
                            "type": "select",
                            "name": "businessUnit",
                            "label": "Business Unit",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "required": true,
                            "options": [
                              { "label": "Room", "value": "ROOM" },
                              { "label": "F&B", "value": "FNB" },
                              { "label": "Health", "value": "HEALTH" }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-number",
                            "name": "targetSpending",
                            "label": "Target Spending",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "placeholder": "Please input"
                          },
                          {
                            "type": "select",
                            "name": "currency",
                            "label": "Currency",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "options": [
                              { "label": "HKD", "value": "HKD" },
                              { "label": "USD", "value": "USD" },
                              { "label": "CNY", "value": "CNY" }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-number",
                            "name": "noOfNights",
                            "label": "No. of Nights",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "placeholder": "Please input"
