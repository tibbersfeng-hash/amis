                          {
                            "type": "select",
                            "name": "source",
                            "label": "Source",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "options": [
                              { "label": "Direct", "value": "DIRECT" },
                              { "label": "OTA", "value": "OTA" }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "select",
                            "name": "marketCode",
                            "label": "Market Code",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "sourceKey": "marketCodes",
                            "options": [
                              { "label": "GDS", "value": "GDS" },
                              { "label": "CORPORATE", "value": "CORPORATE" }
                            ],
                            "placeholder": "Please Select"
                          },
                          {
                            "type": "select",
                            "name": "rateCode",
                            "label": "Rate Code",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "sourceKey": "rateCodes",
                            "options": [
                              { "label": "RACK", "value": "RACK" },
                              { "label": "BAR", "value": "BAR" }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "select",
                            "name": "roomCategory",
                            "label": "Room Category",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "sourceKey": "roomCategories",
                            "options": [
                              { "label": "Deluxe", "value": "DELUXE" },
                              { "label": "Premier", "value": "PREMIER" }
                            ],
                            "placeholder": "Please Select"
                          },
                          {
                            "type": "select",
                            "name": "roomType",
                            "label": "Room Type",
                            "sourcePath": "subMissionRules[0].ruleSetup",
                            "sourceKey": "roomTypes",
                            "options": [
                              { "label": "King", "value": "KING" },
                              { "label": "Twin", "value": "TWIN" }
                            ],
                            "placeholder": "Please Select"
                          }
                        ]
                      },
                      {
                        "type": "date-range-picker",
                        "startName": "subStayStart",
                        "endName": "subStayEnd",
                        "sourcePath": "subMissionRules[0].ruleSetup.stayPeriod",
                        "required": false,
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "validationText": "<div class=\"cxd-Form-validation is-error\" style=\"color:var(--danger);font-size:12px;line-height:1;margin-top:4px;\">End time must be after start time</div>"
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Registration Award</div>",
                        "inline": false
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"radio-group\"><label class=\"radio-item\"><input type=\"radio\" name=\"regAwardType\" value=\"AWARD_POINTS\" checked> Award Points</label><label class=\"radio-item\"><input type=\"radio\" name=\"regAwardType\" value=\"AWARD_VOUCHER\"> Voucher</label><label class=\"radio-item\"><input type=\"radio\" name=\"regAwardType\" value=\"NO_AWARD\"> No Award</label></div>",
                        "inline": false
                      },
                      {
                        "type": "wrapper",
                        "className": "award-panel",
                        "body": {
                          "type": "form",
                          "mode": "normal",
                          "wrapWithPanel": false,
                          "body": [
                            {
                              "type": "input-number",
                              "name": "awardPoints",
                              "label": "Award Points",
                              "sourcePath": "subMissionRules[0].ruleSetup",
                              "placeholder": "Please input"
                            },
                            {
                              "type": "select",
                              "name": "billingCode",
                              "label": "Billing Code",
                              "sourcePath": "subMissionRules[0].ruleSetup",
                              "options": [
                                { "label": "BCODE_ROOM_001", "value": "BCODE_ROOM_001" },
                                { "label": "BCODE_FNB_001", "value": "BCODE_FNB_001" }
                              ],
                              "placeholder": "Please Select"
                            },
                            {
                              "type": "input-number",
                              "name": "inventory",
                              "label": "库存数",
                              "sourcePath": "subMissionRules[0].ruleSetup",
                              "placeholder": "Please input"
                            },
                            {
                              "type": "input-text",
                              "name": "transactionNote",
                              "label": "Transaction Note",
                              "sourcePath": "subMissionRules[0].ruleSetup",
                              "placeholder": "Please input"
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              },
              {
                "title": "Skin Setting",
                "hash": "skin-setting",
                "body": {
                  "type": "wrapper",
                  "className": "form-card",
                  "body": {
                    "type": "form",
                    "mode": "normal",
                    "wrapWithPanel": false,
                    "body": [
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Skin Setting</div>",
                        "inline": false
                      },
                      {
                        "type": "date-range-picker",
                        "startName": "skinStartTime",
                        "endName": "skinEndTime",
                        "sourcePath": "missionRule.displayConfig.skinSetting.effectivePeriod",
                        "required": false,
                        "format": "YYYY-MM-DD HH:mm:ss",
                        "validationText": "<div class=\"cxd-Form-validation is-error\" style=\"color:var(--danger);font-size:12px;line-height:1;margin-top:4px;\">End time must be after start time</div>"
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-color",
                            "name": "backgroundColor",
                            "label": "Background Color",
                            "sourcePath": "missionRule.displayConfig.skinSetting"
                          },
                          {
                            "type": "input-color",
                            "name": "fontColor",
                            "label": "Font Color",
                            "sourcePath": "missionRule.displayConfig.skinSetting"
                          }
                        ]
                      },
                      {
                        "type": "input-image",
                        "name": "taskNotStartedIcon",
                        "label": "Task Not Started Icon",
                        "sourcePath": "missionRule.displayConfig.skinSetting"
                      },
                      {
                        "type": "input-image",
                        "name": "taskInProgressIcon",
                        "label": "Task In Progress Icon",
                        "sourcePath": "missionRule.displayConfig.skinSetting"
                      }
                    ]
                  }
                }
              },
              {
                "title": "Countdown Push",
                "hash": "countdown-push",
                "body": {
                  "type": "wrapper",
                  "className": "form-card",
                  "body": {
                    "type": "form",
                    "mode": "normal",
                    "wrapWithPanel": false,
                    "body": [
                      {
                        "type": "tpl",
