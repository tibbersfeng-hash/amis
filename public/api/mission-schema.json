                              "placeholder": "Please input"
                            },
                            {
                              "type": "select",
                              "name": "specialBillingCode",
                              "label": "Billing Code",
                              "sourcePath": "registrationRule.ruleSetup.registrationSpecialAward.pointsRule",
                              "sourceKey": "billingCode",
                              "options": [
                                { "label": "BCODE_REG_001", "value": "BCODE_REG_001" },
                                { "label": "BCODE_REG_002", "value": "BCODE_REG_002" }
                              ],
                              "placeholder": "Please Select"
                            },
                            {
                              "type": "input-number",
                              "name": "specialInventory",
                              "label": "库存数",
                              "sourcePath": "registrationRule.ruleSetup.registrationSpecialAward.pointsRule",
                              "sourceKey": "inventory",
                              "placeholder": "Please input"
                            },
                            {
                              "type": "input-text",
                              "name": "specialTransactionNote",
                              "label": "Transaction Note",
                              "sourcePath": "registrationRule.ruleSetup.registrationSpecialAward.pointsRule",
                              "sourceKey": "transactionNote",
                              "placeholder": "Please input"
                            }
                          ]
                        }
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\" style=\"margin-top:24px;\">Limitation</div>",
                        "inline": false
                      },
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"radio-group\"><label class=\"radio-item\"><input type=\"radio\" name=\"limitType\" value=\"every\" checked> Every</label><label class=\"radio-item\"><input type=\"radio\" name=\"limitType\" value=\"specified\"> Specified Ranking</label></div>",
                        "inline": false
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "input-number",
                            "name": "limitEvery",
                            "label": "",
                            "sourcePath": "registrationRule.ruleSetup.registrationSpecialAward.limitation",
                            "sourceKey": "everyN",
                            "placeholder": "Please input"
                          },
                          {
                            "type": "tpl",
                            "tpl": "<div style=\"padding-top:32px;color:var(--text-secondary);font-size:13px;\">members</div>",
                            "inline": false
                          },
                          {
                            "type": "input-number",
                            "name": "limitRanking",
                            "label": "",
                            "sourcePath": "registrationRule.ruleSetup.registrationSpecialAward.limitation",
                            "sourceKey": "specifiedRanking",
                            "placeholder": "Please input"
                          }
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "type": "wrapper",
          "className": "mission-right",
          "body": {
            "type": "wrapper",
