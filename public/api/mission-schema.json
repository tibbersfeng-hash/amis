              {
                "type": "tpl",
                "tpl": "<div class=\"language-switcher\"><span class=\"language-label\">Preview Language:</span><select class=\"language-select\" onchange=\"window.__onPreviewLanguageChange && window.__onPreviewLanguageChange(this.value)\"><option value=\"zh\">中文</option><option value=\"en\">English</option></select></div>",
                "inline": false
              },
              {
                "type": "wrapper",
                "className": "phone-card",
                "body": { "type": "phone-mockup" }
              }
            ]
          }
        }
      ]
    }
  ]
