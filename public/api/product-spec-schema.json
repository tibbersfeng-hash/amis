{
  "type": "page",
  "title": "产品多规格配置",
  "className": "mission-root",
  "body": [
    {
      "type": "wrapper",
      "className": "form-card",
      "body": [
        {
          "type": "combo",
          "name": "specs",
          "label": "规格列表",
          "multiple": true,
          "multiLine": true,
          "addable": true,
          "removable": true,
          "deletable": true,
          "draggable": true,
          "items": [
            {
              "type": "input-text",
              "name": "specName",
              "label": "规格名称",
              "placeholder": "如：红色/XL",
              "required": true
            },
            {
              "type": "input-text",
              "name": "skuCode",
              "label": "SKU 编号",
              "placeholder": "请输入 SKU 编号",
              "required": true
            },
            {
              "type": "input-number",
              "name": "price",
              "label": "价格",
              "placeholder": "请输入价格",
              "required": true,
              "precision": 2,
              "min": 0
            },
            {
              "type": "input-number",
              "name": "stock",
              "label": "库存",
              "placeholder": "请输入库存数量",
              "required": true,
              "precision": 0,
              "min": 0
            },
            {
              "type": "input-number",
              "name": "weight",
              "label": "重量",
              "placeholder": "请输入重量",
              "precision": 2,
              "min": 0,
              "suffix": "kg"
            },
            {
              "type": "input-text",
              "name": "barcode",
              "label": "条码",
              "placeholder": "请输入商品条码"
            },
            {
              "type": "switch",
              "name": "isOnSale",
              "label": "是否上架",
              "onText": "上架",
              "offText": "下架"
            },
            {
              "type": "textarea",
              "name": "remark",
              "label": "备注",
              "placeholder": "请输入备注信息",
              "minRows": 2
            }
          ]
        }
      ]
    }
  ]
}
