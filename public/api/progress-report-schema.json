{
  "type": "page",
  "className": "mission-root",
  "data": {},
  "body": [
    {
      "type": "wrapper",
      "className": "page-header-bar",
      "body": [
        {
          "type": "tpl",
          "tpl": "<h1 class=\"page-title\">项目进度填报</h1>",
          "inline": false
        },
        {
          "type": "button",
          "label": "返回列表",
          "className": "return-link",
          "actionType": "link",
          "link": "index.html?page=list"
        }
      ]
    },
    {
      "type": "wrapper",
      "className": "form-card",
      "body": {
        "type": "tabs",
        "tabsMode": "line",
        "className": "custom-closable-tabs",
        "mountOnEnter": false,
        "unmountOnExit": false,
        "tabs": [
          {
            "title": "项目一",
            "closable": true,
            "body": {
              "type": "form",
              "wrapWithPanel": false,
              "mode": "normal",
              "data": {
                "projectName": "",
                "projectManager": "",
                "currentPhase": "",
                "completionPercentage": 0,
                "weeklyProgress": "",
                "nextWeekPlan": "",
                "riskDescription": "",
                "isDelayed": false
              },
              "body": [
                {
                  "type": "input-text",
                  "name": "projectName",
                  "label": "项目名称",
                  "sourcePath": "projects[0]",
                  "sourceKey": "projectName",
                  "required": true,
                  "placeholder": "请输入项目名称"
                },
                {
                  "type": "input-text",
                  "name": "projectManager",
                  "label": "项目经理",
                  "sourcePath": "projects[0]",
                  "sourceKey": "projectManager",
                  "required": true,
                  "placeholder": "请输入项目经理"
                },
                {
                  "type": "select",
                  "name": "currentPhase",
                  "label": "当前阶段",
                  "sourcePath": "projects[0]",
                  "sourceKey": "currentPhase",
                  "required": true,
                  "placeholder": "请选择",
                  "options": [
                    { "label": "需求", "value": "requirement" },
                    { "label": "开发", "value": "development" },
                    { "label": "测试", "value": "testing" },
                    { "label": "上线", "value": "launch" }
                  ]
                },
                {
                  "type": "input-number",
                  "name": "completionPercentage",
                  "label": "完成百分比",
                  "sourcePath": "projects[0]",
                  "sourceKey": "completionPercentage",
                  "required": true,
                  "placeholder": "0-100",
                  "min": 0,
                  "max": 100
                },
                {
                  "type": "textarea",
                  "name": "weeklyProgress",
                  "label": "本周进度",
                  "sourcePath": "projects[0]",
                  "sourceKey": "weeklyProgress",
                  "placeholder": "请输入本周进度描述",
                  "rows": 3
                },
                {
                  "type": "textarea",
                  "name": "nextWeekPlan",
                  "label": "下周计划",
                  "sourcePath": "projects[0]",
                  "sourceKey": "nextWeekPlan",
                  "placeholder": "请输入下周计划",
                  "rows": 3
                },
                {
                  "type": "textarea",
                  "name": "riskDescription",
                  "label": "风险说明",
                  "sourcePath": "projects[0]",
                  "sourceKey": "riskDescription",
                  "placeholder": "请输入风险说明（如有）",
                  "rows": 3
                },
                {
                  "type": "switch",
                  "name": "isDelayed",
                  "label": "是否延期",
                  "sourcePath": "projects[0]",
                  "sourceKey": "isDelayed",
                  "onText": "是",
                  "offText": "否"
                }
              ],
              "actions": [
                { "type": "submit", "label": "提交", "level": "primary" }
              ]
            }
          },
          {
            "title": "项目二",
            "closable": true,
            "body": {
              "type": "form",
              "wrapWithPanel": false,
              "mode": "normal",
              "data": {
                "projectName": "",
                "projectManager": "",
                "currentPhase": "",
                "completionPercentage": 0,
                "weeklyProgress": "",
                "nextWeekPlan": "",
                "riskDescription": "",
                "isDelayed": false
              },
              "body": [
                {
                  "type": "input-text",
                  "name": "projectName",
                  "label": "项目名称",
                  "sourcePath": "projects[1]",
                  "sourceKey": "projectName",
                  "required": true,
                  "placeholder": "请输入项目名称"
                },
                {
                  "type": "input-text",
                  "name": "projectManager",
                  "label": "项目经理",
                  "sourcePath": "projects[1]",
                  "sourceKey": "projectManager",
                  "required": true,
                  "placeholder": "请输入项目经理"
                },
                {
                  "type": "select",
                  "name": "currentPhase",
                  "label": "当前阶段",
                  "sourcePath": "projects[1]",
                  "sourceKey": "currentPhase",
                  "required": true,
                  "placeholder": "请选择",
                  "options": [
                    { "label": "需求", "value": "requirement" },
                    { "label": "开发", "value": "development" },
                    { "label": "测试", "value": "testing" },
                    { "label": "上线", "value": "launch" }
                  ]
                },
                {
                  "type": "input-number",
                  "name": "completionPercentage",
                  "label": "完成百分比",
                  "sourcePath": "projects[1]",
                  "sourceKey": "completionPercentage",
                  "required": true,
                  "placeholder": "0-100",
                  "min": 0,
                  "max": 100
                },
                {
                  "type": "textarea",
                  "name": "weeklyProgress",
                  "label": "本周进度",
                  "sourcePath": "projects[1]",
                  "sourceKey": "weeklyProgress",
                  "placeholder": "请输入本周进度描述",
                  "rows": 3
                },
                {
                  "type": "textarea",
                  "name": "nextWeekPlan",
                  "label": "下周计划",
                  "sourcePath": "projects[1]",
                  "sourceKey": "nextWeekPlan",
                  "placeholder": "请输入下周计划",
                  "rows": 3
                },
                {
                  "type": "textarea",
                  "name": "riskDescription",
                  "label": "风险说明",
                  "sourcePath": "projects[1]",
                  "sourceKey": "riskDescription",
                  "placeholder": "请输入风险说明（如有）",
                  "rows": 3
                },
                {
                  "type": "switch",
                  "name": "isDelayed",
                  "label": "是否延期",
                  "sourcePath": "projects[1]",
                  "sourceKey": "isDelayed",
                  "onText": "是",
                  "offText": "否"
                }
              ],
              "actions": [
                { "type": "submit", "label": "提交", "level": "primary" }
              ]
            }
          }
        ]
      }
    }
  ]
}
