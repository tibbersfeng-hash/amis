{
  "type": "page",
  "body": {
    "type": "tabs",
    "tabsMode": "line",
    "className": "custom-underline-tabs",
    "tabs": [
      {
        "title": "Mission Rule",
        "body": {
          "type": "tabs",
          "className": "custom-solid-fill-tabs",
          "tabs": [
            {
              "title": "Rule Setup",
              "body": {
                "type": "form",
                "wrapWithPanel": false,
                "body": [
                  {
                    "type": "group",
                    "body": [
                      {
                        "type": "input-text",
                        "name": "missionCode",
                        "label": "Mission Code",
                        "required": true,
                        "placeholder": "Please input"
                      },
                      {
                        "type": "input-text",
                        "name": "missionName",
                        "label": "Mission Name",
                        "required": true,
                        "placeholder": "Please input"
                      }
                    ]
                  },
                  {
                    "type": "radios",
                    "name": "displayInMissionCenter",
                    "label": "Display In Mission Center",
                    "options": [
                      { "label": "Yes", "value": "yes" },
                      { "label": "No", "value": "no" }
                    ]
                  },
                  {
                    "type": "input-date-range",
                    "name": "registrationPeriod",
                    "label": "Registration Period",
                    "required": true,
                    "format": "YYYY-MM-DD HH:mm:ss",
                    "placeholder": "Select date range"
                  },
                  {
                    "type": "input-date-range",
                    "name": "missionPeriod",
                    "label": "Mission Period",
                    "required": true,
                    "format": "YYYY-MM-DD HH:mm:ss",
                    "placeholder": "Select date range"
                  },
                  {
                    "type": "radios",
                    "name": "quotaType",
                    "label": "Quota",
                    "options": [
                      { "label": "No Limit", "value": "noLimit" },
                      { "label": "Limit to", "value": "limit" }
                    ]
                  },
                  {
                    "type": "input-number",
                    "name": "quotaMax",
                    "label": "Quota Limit",
                    "placeholder": "max SLC members",
                    "visibleOn": "this.quotaType == 'limit'"
                  },
                  {
                    "type": "radios",
                    "name": "minRegistrationType",
                    "label": "Minimum Registration",
                    "options": [
                      { "label": "No Limit", "value": "noLimit" },
                      { "label": "Show enrollment numbers if more than", "value": "show" }
                    ]
                  },
                  {
                    "type": "input-number",
                    "name": "minRegistrationCount",
                    "label": "Min Registration Count",
                    "visibleOn": "this.minRegistrationType == 'show'"
                  },
                  {
                    "type": "select",
                    "name": "registrationKeyword",
                    "label": "Registration Keyword",
                    "placeholder": "Please Select",
                    "options": [],
                    "searchable": true
                  },
                  {
                    "type": "select",
                    "name": "limitationKeyword",
                    "label": "Limitation Keyword",
                    "placeholder": "Please Select",
                    "options": [],
                    "searchable": true
                  },
                  {
                    "type": "radios",
                    "name": "sequentialType",
                    "label": "Sequential or Non-sequential",
                    "options": [
                      { "label": "Continuous", "value": "continuous" },
                      { "label": "Independent", "value": "independent" }
                    ]
                  }
                ]
              }
            },
            {
              "title": "Display",
              "body": {
                "type": "form",
                "wrapWithPanel": false,
                "body": [
                  {
                    "type": "input-image",
                    "name": "missionThumbnail",
                    "label": "Mission Thumbnail",
                    "required": true,
                    "remark": "Recommended Dimensions:10*10, The Maximum size of file is 30MB"
                  },
                  {
                    "type": "group",
                    "body": [
                      {
                        "type": "input-text",
                        "name": "missionShortName",
                        "label": "Mission Short Name",
                        "required": true,
                        "placeholder": "Please input"
                      },
                      {
                        "type": "input-text",
                        "name": "missionLongName",
                        "label": "Mission Long Name",
                        "placeholder": "Please input"
                      }
                    ]
                  },
                  {
                    "type": "input-text",
                    "name": "missionDescription",
                    "label": "Mission Description",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "input-text",
                    "name": "awardDescription",
                    "label": "Award Description",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "group",
                    "body": [
                      {
                        "type": "input-image",
                        "name": "missionSegmentIcon",
                        "label": "Mission Segment Icon",
                        "remark": "Recommended Dimensions:10*10, The Maximum size of file is 30MB"
                      },
                      {
                        "type": "textarea",
                        "name": "missionSegmentDescription",
                        "label": "Mission Segment Description",
                        "placeholder": "Please input"
                      }
                    ]
                  },
                  {
                    "type": "input-rich-text",
                    "name": "missionDetail",
                    "label": "Mission Detail",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "input-text",
                    "name": "tandcLink",
                    "label": "T&C Link",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "input-rich-text",
                    "name": "tandcContent",
                    "label": "T&C Content",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "input-text",
                    "name": "shareLink",
                    "label": "Share Link",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "input-text",
                    "name": "startMission",
                    "label": "Start Mission",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "wrapper",
                    "className": "award-panel",
                    "body": [
                      {
                        "type": "tpl",
                        "tpl": "<div class=\"section-title-sm\">Skin Setting</div>"
                      },
                      {
                        "type": "input-date-range",
                        "name": "effectivePeriod",
                        "label": "Effective Period",
                        "format": "YYYY-MM-DD HH:mm:ss"
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "tpl",
                            "tpl": "<span class=\"cxd-Form-item-label\">Background Color</span>"
                          },
                          {
                            "type": "switch",
                            "name": "bgColorDefault",
                            "label": "Default"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "visibleOn": "this.bgColorDefault !== true",
                        "body": [
                          {
                            "type": "input-text",
                            "name": "bgColorR",
                            "label": "R",
                            "placeholder": "R"
                          },
                          {
                            "type": "input-text",
                            "name": "bgColorG",
                            "label": "G",
                            "placeholder": "G"
                          },
                          {
                            "type": "input-text",
                            "name": "bgColorB",
                            "label": "B",
                            "placeholder": "B"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "body": [
                          {
                            "type": "tpl",
                            "tpl": "<span class=\"cxd-Form-item-label\">Font Color</span>"
                          },
                          {
                            "type": "switch",
                            "name": "fontColorDefault",
                            "label": "Default"
                          }
                        ]
                      },
                      {
                        "type": "group",
                        "visibleOn": "this.fontColorDefault !== true",
                        "body": [
                          {
                            "type": "input-text",
                            "name": "fontColorR",
                            "label": "R",
                            "placeholder": "R"
                          },
                          {
                            "type": "input-text",
                            "name": "fontColorG",
                            "label": "G",
                            "placeholder": "G"
                          },
                          {
                            "type": "input-text",
                            "name": "fontColorB",
                            "label": "B",
                            "placeholder": "B"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "title": "Registration Rule",
        "body": {
          "type": "tabs",
          "className": "custom-solid-fill-tabs",
          "tabs": [
            {
              "title": "Rule Setup",
              "body": {
                "type": "form",
                "wrapWithPanel": false,
                "body": [
                  {
                    "type": "input-text",
                    "name": "regRuleName",
                    "label": "Rule Name",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "select",
                    "name": "regRuleType",
                    "label": "Rule Type",
                    "placeholder": "Please Select",
                    "options": []
                  }
                ]
              }
            },
            {
              "title": "Display",
              "body": {
                "type": "form",
                "wrapWithPanel": false,
                "body": [
                  {
                    "type": "input-text",
                    "name": "regDisplayTitle",
                    "label": "Display Title",
                    "placeholder": "Please input"
                  },
                  {
                    "type": "textarea",
                    "name": "regDisplayContent",
                    "label": "Display Content",
                    "placeholder": "Please input"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "title": "Sub Mission Rule",
        "body": {
          "type": "wrapper",
          "body": []
        }
      }
    ]
  }
}
