{
  "pageType": "formPage",
  "pageTitle": "三级联动表单",
  "className": "mission-root",
  "fields": [
    {
      "type": "select",
      "props": {
        "name": "category",
        "label": "分类",
        "placeholder": "请选择分类",
        "required": true,
        "options": [
          { "label": "手机", "value": "phone" },
          { "label": "电脑", "value": "computer" },
          { "label": "平板", "value": "tablet" }
        ]
      }
    },
    {
      "type": "select",
      "props": {
        "name": "brand",
        "label": "品牌",
        "placeholder": "请先选择分类",
        "required": true,
        "options": []
      }
    },
    {
      "type": "select",
      "props": {
        "name": "model",
        "label": "型号",
        "placeholder": "请先选择品牌",
        "required": true,
        "options": []
      }
    },
    {
      "type": "divider",
      "props": {}
    },
    {
      "type": "input-number",
      "props": {
        "name": "quantity",
        "label": "数量",
        "placeholder": "请输入数量",
        "required": true,
        "min": 1,
        "value": 1
      }
    },
    {
      "type": "textarea",
      "props": {
        "name": "remark",
        "label": "备注",
        "placeholder": "请输入备注信息",
        "rows": 3
      }
    }
  ]
}
